[Unit]
Description=AI Researcher ingest run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AI-Researcher
ExecStart=%h/AI-Researcher/.venv/bin/ai-researcher run

# A full run fetches ~60 sources, paces Reddit at ~75s per subreddit, and then
# spends its model budget. Generous ceiling so a slow run is not killed midway.
TimeoutStartSec=2700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/AI-Researcher/data
